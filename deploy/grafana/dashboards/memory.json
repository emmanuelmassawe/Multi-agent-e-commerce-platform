{
  "uid": "clos-memory",
  "title": "Customer memory",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Support retrieval p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(retrieval_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Empty searches per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(retrieval_empty_total[5m])"
        }
      ]
    },
    {
      "id": 3,
      "title": "Oldest pending memory job",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_lag_seconds"
        }
      ]
    },
    {
      "id": 4,
      "title": "Drift detections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "qdrant_drift_total"
        }
      ]
    }
  ]
}
